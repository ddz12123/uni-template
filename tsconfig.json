{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    // 官方例子是 node（历史遗留），vite 工程用 bundler 才是对的：配合 package.json exports 解析，
    // 且与 HBuilderX 内置 vite 行为一致，故意不跟官方例子
    "moduleResolution": "bundler",
    // 官方例子是 esnext；小程序 JSC API 停留在 ES2020 水平，lib 取 ES2020 更贴近真机，
    // 避免编辑器里用了真机不存在的新 API 也不报错
    "lib": ["ES2020", "DOM"],
    "strict": true,
    // 官方例子有 jsx: preserve；模板暂不用 JSX，但保留该项，未来要用时无需再查
    "jsx": "preserve",
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    // 官方例子 types 只有 @dcloudio/types；@wot-ui/ui/global 提供 wot 组件的模板类型，必须保留
    "types": ["@dcloudio/types", "@wot-ui/ui/global"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
    // 注：官方例子的 sourceMap（noEmit 下无意义）、importHelpers（需额外装 tslib）、
    // allowSyntheticDefaultImports（esModuleInterop 已涵盖）均不取
  },
  "include": ["**/*.ts", "**/*.d.ts", "**/*.vue"],
  "exclude": ["node_modules", "unpackage", "dist", "**/*.nvue"]
}
