# 应用名称统一维护在 manifest.json 的 name，此文件不配置标题。

# 开发/生产环境分别复制为本地环境文件后填写
VITE_APP_BASE_URL=https://api.example.com

# 留空时只在开发环境打印错误，不发送到服务端
VITE_REPORT_URL=

# 静态资源公共前缀：本地开发用 '/static'（项目根 static/ 目录），生产填 CDN 地址。
# ts 运行时读此变量（utils/static.ts）；scss 的 $cdn 由 `npm run sync:cdn` 从 .env.production 同步。
# 注意：切 CDN 后需在微信公众平台配置 downloadFile 合法域名。
VITE_PUBLIC_PATH = '/static'
