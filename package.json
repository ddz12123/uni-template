{
  "name": "uni-hbx-enterprise-template",
  "version": "1.0.0",
  "private": true,
  "description": "企业级开箱即用的 uni-app HBuilderX 模板（Vue3 + TS + Pinia + Wot UI v2）",
  "scripts": {
    "sync:cdn": "node scripts/sync-cdn.mjs",
    "sync:cdn:dev": "node scripts/sync-cdn.mjs development",
    "sync:cdn:prod": "node scripts/sync-cdn.mjs production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@vueuse/core": "^11.3.0",
    "@wot-ui/ui": "^2.3.2",
    "pinia-plugin-persistedstate": "4.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@dcloudio/types": "^3.4.12",
    "eslint": "^9.20.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.4.2",
    "typescript": "~5.4.5",
    "vue": "3.4.21",
    "vue-tsc": "2.2.12"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
