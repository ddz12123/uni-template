# EditorConfig: https://editorconfig.org
# 统一不同编辑器 / IDE 的基础排版，与 Prettier 保持一致（2 空格缩进、LF、UTF-8）。
# Prettier 会读取本文件的 end_of_line / indent_size 作为默认值，二者不冲突。
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown 行尾双空格是「硬换行」语义，保留尾随空格
[*.md]
trim_trailing_whitespace = false
